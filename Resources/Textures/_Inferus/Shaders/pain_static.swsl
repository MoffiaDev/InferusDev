// pain distortion shader

uniform sampler2D SCREEN_TEXTURE;

uniform highp float painLevel;

const highp float PainRadiusMax = 1;
const highp float PainRadiusMin = 0.25;
const highp float PainEdgeSoftness = 0.15;
const highp float PainPulseRate = 0.25;
const highp float PainPulseAmount = 0.15;
const highp float StaticSpeed = 30;
const highp float StaticStrength = 0.5;
const highp float WanderAmount = 0.075;

const highp float MaxSpikeDepth = 0.2;
const highp float EdgeRoughness = 0.05;

const highp float DistortStart = 0.80;
const highp float DistortEnd = 0.95;
const highp float MaxViewDistort = 0.0015;

highp float hash12(highp vec2 p) {
    highp vec3 p3 = fract(vec3(p.x, p.y, p.x) * 0.1031);
    highp float d = dot(p3, p3.yzx + 33.33);
    p3 += vec3(d);
    return fract((p3.x + p3.y) * p3.z);
}

void fragment() {
    highp vec2 coord = FRAGCOORD.xy * SCREEN_PIXEL_SIZE.xy;
    highp float t = TIME;

    highp float distort = smoothstep(DistortStart, DistortEnd, painLevel) * MaxViewDistort;
    highp vec2 viewOffset = vec2(
        sin(t * 1.3 + coord.y * 5.0),
        cos(t * 0.9 + coord.x * 4.0) * 0.5
    ) * distort;

    highp vec4 color = zTextureSpec(SCREEN_TEXTURE, coord + viewOffset);

    highp float pulse = 1.0 + PainPulseAmount * sin(t * PainPulseRate);

    highp vec2 wander = vec2(
        sin(t * 0.23) * 0.7 + sin(t * 0.11 + 2.0) * 0.3,
        cos(t * 0.17 + 1.0) * 0.7 + cos(t * 0.09 + 3.0) * 0.3
    ) * WanderAmount;

    highp float aspect = SCREEN_PIXEL_SIZE.y / SCREEN_PIXEL_SIZE.x;
    highp vec2 p = (coord - 0.5) * vec2(aspect, 1.0) - wander;
    highp float dist = length(p);

    highp float seed = floor(t * StaticSpeed);
    highp float grain = hash12(FRAGCOORD.xy + vec2(seed * 13.7, seed * 7.3));

    highp float radius = mix(PainRadiusMax, PainRadiusMin, painLevel) * pulse;

    highp float theta = atan(p.y, p.x);
    highp float spikeNoise = sin(theta * 9.0 + t * 0.4)
                           + sin(theta * 17.0 - t * 0.27 + 2.1) * 0.5;
    spikeNoise = clamp(spikeNoise / 1.5 * 0.5 + 0.5, 0.0, 1.0);
    highp float spikeEnv = 0.5 + 0.5 * sin(t * 0.45 + theta * 2.0); // Inferus - spikes come and go
    highp float spikeDepth = MaxSpikeDepth * spikeNoise * spikeNoise * spikeEnv;
    highp float edge = radius - spikeDepth;

    edge += (grain - 0.5) * EdgeRoughness;

    highp float redMask = smoothstep(edge, edge + PainEdgeSoftness, dist);

    highp vec3 redVignette = mix(vec3(0.34, 0.01, 0.01), vec3(0.9, 0.15, 0.12), grain * StaticStrength);
    color.rgb = mix(color.rgb, redVignette, redMask);

    COLOR = color;
}
